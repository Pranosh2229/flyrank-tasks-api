# Copy this file to .env and adjust if needed. .env itself is git-ignored.
POSTGRES_USER=tasks_user
POSTGRES_PASSWORD=tasks_password
POSTGRES_DB=tasks

# Used by the app container to connect to the db service (service name "db"
# is the hostname on the docker-compose network, not localhost).
DATABASE_URL=postgresql://tasks_user:tasks_password@db:5432/tasks

# BE-03: Supabase Auth (Identity Provider). Project Settings -> API in your
# Supabase dashboard. Use the anon/public key here — never the service_role key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_anon_key
PORT=8000
